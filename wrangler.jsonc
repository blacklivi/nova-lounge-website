{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-lounge-demo",
  "main": "./src/index.js",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "preview_urls": true,
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/api/*",
      "/media/upload-*",
      "/admin",
      "/events"
    ],
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nova-content-db",
      "database_id": "b8839516-465c-4426-a0c4-acea4c71e68f"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "nova-website-media"
    }
  ],
  "ai": {
    "binding": "AI"
  }
}
