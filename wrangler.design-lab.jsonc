{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-design-lab",
  "main": "./src/design-lab.js",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
